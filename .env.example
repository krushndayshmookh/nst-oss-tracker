# Copy to .env for local development and load it with:  node --env-file=.env src/server.js
# (.env is git-ignored. Never commit real values. In Kubernetes the three secrets come from the
#  Secret `oss-status-secrets`, see k8s/secret.example.yaml.)

# HTTP port of the app
PORT=3000

# MongoDB connection and database name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=oss_status

# (with authentication: mongodb://oss_status:<password>@host:27017/oss_status?authSource=oss_status)

# Password of the admin area (/admin). If unset, every admin API route answers 503.
# In production it must be at least 16 characters and not a placeholder, or the admin area stays closed.
ADMIN_PASSWORD=

# Key that signs the admin session cookie (together with ADMIN_PASSWORD: changing the password signs everyone out).
# If unset, a random key is generated per process, so admin sessions end at every restart.
# Required in production, at least 32 characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# GitHub token used by sync / backfill and by "add student" validation.
# A classic token without any scope (or a fine-grained token with public read access) is enough:
# only public data is read. Required by scripts/sync.js and scripts/backfill.js.
GITHUB_TOKEN=

# Optional: base URL of the GitHub API (default https://api.github.com). GraphQL is called at <base>/graphql.
# Only needed for GitHub Enterprise or to point the fetchers at a local fake server in tests.
# GITHUB_API_URL=

# development | production | test. "production" marks the admin cookie Secure (HTTPS only).
NODE_ENV=development

# Students fetched in parallel by sync / backfill
SYNC_CONCURRENCY=6

# Express "trust proxy" setting: number of reverse proxies in front of the app (Traefik = 1)
TRUST_PROXY=1

# Header that carries the visitor's address when the app sits behind a CDN (Cloudflare: CF-Connecting-IP).
# It is the key of the login limit and the request budgets, and is only believed when the TCP peer is a private
# address (the in-cluster ingress). Leave unset locally.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Time zone of date ranges, chart buckets, the academic year and the nightly fetch time
TZ_NAME=Asia/Kolkata

# The app schedules the nightly fetch itself (Admin -> Jobs -> Scheduled fetch). "off" disables that in this process.
# SCHEDULER=off

# Public API: in-memory cache of identical answers (ms), per-visitor budgets per minute, concurrent CSV exports
# PUBLIC_CACHE_MS=60000
# RATE_LIMIT_PER_MIN=300
# EXPORT_LIMIT_PER_MIN=6
# MAX_CONCURRENT_EXPORTS=2
