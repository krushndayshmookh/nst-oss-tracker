# Copy to .env for local development and load it with:  node --env-file=.env src/server.js
# (.env is git-ignored. Never commit real values. In Kubernetes the three secrets come from the
#  Secret `oss-status-secrets`, see k8s/secret.example.yaml.)

# HTTP port of the app
PORT=3000

# MongoDB connection and database name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=oss_status

# Password of the admin area (/admin). If unset, every admin API route answers 503.
ADMIN_PASSWORD=

# Key that signs the admin session cookie. If unset, a random key is generated per process,
# so admin sessions end at every restart. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# GitHub token used by sync / backfill and by "add student" validation.
# A classic token without any scope (or a fine-grained token with public read access) is enough:
# only public data is read. Required by scripts/sync.js and scripts/backfill.js.
GITHUB_TOKEN=

# Optional: base URL of the GitHub API (default https://api.github.com). GraphQL is called at <base>/graphql.
# Only needed for GitHub Enterprise or to point the fetchers at a local fake server in tests.
# GITHUB_API_URL=

# development | production | test. "production" marks the admin cookie Secure (HTTPS only).
NODE_ENV=development

# Students fetched in parallel by sync / backfill
SYNC_CONCURRENCY=6

# Express "trust proxy" setting: number of reverse proxies in front of the app (Traefik = 1)
TRUST_PROXY=1
